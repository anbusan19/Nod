# Copy to .env.production and fill in. Never commit the real file.

# REQUIRED. A long random string, set once and never changed (changing it invalidates every key and token).
#   openssl rand -hex 32
AGENT_API_KEY_SALT=

# Which cluster agents are proposing for by default, and the RPC nodes the backend uses for blockhashes.
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com

# Push notifications (optional but recommended). Paste the Firebase service-account JSON as base64:
#   base64 -i firebase-service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Limits
PROPOSAL_TTL_SECONDS=90
RATE_LIMIT_PER_MINUTE=240
DEFAULT_AUTO_LIMIT_USD=5
DEFAULT_HARD_CAP_USD=500
