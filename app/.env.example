# Optional. Leave EXPO_PUBLIC_API_URL empty so the app asks the user for their own Nod backend on first launch.
# For local development over USB: EXPO_PUBLIC_API_URL=http://localhost:3000  (and run: adb reverse tcp:3000 tcp:3000)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
