{
  "name": "nod-sdk",
  "version": "0.2.1",
  "description": "Connect any AI agent to Nod: propose Solana transactions that a human approves on their phone.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./solana": {
      "types": "./dist/solana.d.ts",
      "import": "./dist/solana.js",
      "require": "./dist/solana.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts src/solana.ts src/cli.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "conformance": "vitest run test/integration.test.ts"
  },
  "peerDependencies": {
    "@solana/web3.js": "^1.90.0"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solana/web3.js": "^1.99.0",
    "@types/node": "^26.6.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "bin": {
    "nod": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anbusan19/Nod.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/anbusan19/Nod#readme",
  "bugs": {
    "url": "https://github.com/anbusan19/Nod/issues"
  },
  "author": "Anbutaco",
  "keywords": [
    "nod",
    "solana",
    "ai-agent",
    "agents",
    "human-in-the-loop",
    "transaction-approval",
    "mobile-wallet-adapter",
    "jupiter"
  ]
}
